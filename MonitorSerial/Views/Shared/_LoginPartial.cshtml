@using Microsoft.AspNet.Identity

@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post,
        new { id = "logoutForm" }))
    {
        @Html.AntiForgeryToken()

        <ul class="right hide-on-med-and-down">
            <li>
                @Html.ActionLink(
                         "Hola " + User.Identity.GetUserName(),
                         "Index",
                         "Manage",
                         routeValues: null,
                         htmlAttributes: new { @class = "white-text" }
                     )
            </li>

            <li>
                <a href="javascript:document.getElementById('logoutForm').submit()"
                   class="white-text">
                    Cerrar sesión
                </a>
            </li>
        </ul>
    }
}
else
{
    <ul class="right hide-on-med-and-down">
        <li>
            @Html.ActionLink(
                     "Registrarse",
                     "Register",
                     "Account",
                     routeValues: null,
                     htmlAttributes: new { @class = "white-text" }
                 )
        </li>

        <li>
            @Html.ActionLink(
                     "Iniciar sesión",
                     "Login",
                     "Account",
                     routeValues: null,
                     htmlAttributes: new { @class = "white-text" }
                 )
        </li>
    </ul>
}